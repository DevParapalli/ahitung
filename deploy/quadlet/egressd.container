[Unit]
Description=ahitung egressd, the only path to the internet
PartOf=ahitung.target

[Container]
Image=localhost/ahitung/egressd:latest
ContainerName=egressd
Network=ahitung-sandbox.network:ip=10.89.0.2
Network=ahitung-worker-out.network:ip=10.89.1.2
Network=ahitung-outbound.network
Volume=%E/ahitung/egressd.json:/etc/egressd/policy.json:ro,Z
Environment=EGRESSD_POLICY=/etc/egressd/policy.json
Environment=EGRESSD_LISTEN=10.89.0.2,10.89.1.2
Environment=EGRESSD_DNS_ANSWER=10.89.0.2
Environment=EGRESSD_WORKER_IP=10.89.1.3
# Lets UID 10001 bind 53 and 443 inside egressd's own network namespace only.
Sysctl=net.ipv4.ip_unprivileged_port_start=53
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# Exec form: the scratch image has no shell to run a command string.
HealthCmd=["/egressd", "-healthcheck"]
HealthInterval=60s
HealthTimeout=5s
Notify=healthy

[Service]
ExecReload=/usr/bin/podman kill --signal HUP egressd
Restart=on-failure

[Install]
WantedBy=ahitung.target
